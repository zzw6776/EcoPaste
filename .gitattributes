# 默认：所有文本文件在三个平台工作区都使用 LF
* text=auto eol=lf

# Windows 批处理文件例外
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix/Android 可执行脚本必须 LF
*.sh text eol=lf
gradlew text eol=lf
src-tauri/gen/android/gradlew text eol=lf

# SQLx 按原始字节校验 migration，禁止因平台换行差异改变校验和
src-tauri/migrations/*.sql text eol=lf

# 二进制不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.apk binary
*.keystore binary
*.jks binary
*.zip binary
